// Containers on the relay (nginx, uptime-kuma)
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.filter.receiver]
}

// ufw firewall log, through the /var/log directory mount
local.file_match "ufw" {
  path_targets = [{
    "__path__" = "/host/var/log/ufw.log",
    "service"  = "ufw",
  }]
}

loki.source.file "ufw" {
  targets    = local.file_match.ufw.targets
  forward_to = [loki.write.lenovo.receiver]
}

// Drop Uptime Kuma's own health checks so analytics only shows real traffic
loki.process "filter" {
  stage.match {
    selector = "{service=\"nginx\"} |= \"Uptime-Kuma\""
    action   = "drop"
  }
  stage.match {
    selector = "{service=\"nginx\"} |= \"\\\"remote_addr\\\":\\\"RELAY_PUBLIC_IP\\\"\" |= \"\\\"bytes_received\\\":0\""
    action   = "drop"
  }
  forward_to = [loki.write.lenovo.receiver]
}

// Push to Loki on the Lenovo over Tailscale
loki.write "lenovo" {
  endpoint {
    url = "http://100.x.x.x:14310/loki/api/v1/push"
  }
  external_labels = { host = "relay" }
}
